# Discord bot token — from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Command prefix (default: !)
PREFIX=!

# Music backend selection — only meaningful when both `lavalink` and
# `music-native` features are compiled in. Values: lavalink | native.
# Default when both are available: lavalink.
MUSIC_BACKEND=lavalink

# Lavalink node — point at your lavalink-ops instance (lavalink backend only)
LAVALINK_HOST=localhost:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SSL=false

# TTS (GnomedDev/tts-service). Only needed when built with `--features tts`.
TTS_SERVICE_URL=http://localhost:3000
TTS_AUTH_KEY=
TTS_MODE=eSpeak
TTS_VOICE=en
TTS_SPEAKING_RATE=1.0
TTS_MAX_LENGTH=200
TTS_PREFERRED_FORMAT=wav

# STT (speech-to-text). Any OpenAI-compatible `/v1/audio/transcriptions`
# provider works: lemonfox.ai, OpenAI, Groq, Fireworks, or the self-hosted
# `speaches` sidecar in docker-compose. API key is optional — leave empty
# for the sidecar.
#
# Model names differ between providers:
#   speaches  → Hugging Face repo (e.g. Systran/faster-whisper-small,
#               Systran/faster-whisper-large-v3)
#   OpenAI, lemonfox, Groq → whisper-1 (and provider-specific variants)
STT_BASE_URL=http://speaches:8000/v1
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-small
STT_LANGUAGE=

# Bot-hosted HTTP layer — used to serve TTS audio to a remote lavalink node.
# Set BOT_PUBLIC_URL to the URL that lavalink should fetch from (e.g. your
# cloudflared tunnel hostname). Leave unset to disable; TTS on the lavalink
# backend will refuse with a helpful message in that case.
BOT_PUBLIC_URL=
BOT_HTTP_BIND_ADDR=0.0.0.0:8080
BOT_AUDIO_TTL_SECS=60

# Dev convenience: if set, commands are registered to this guild only (instant
# propagation). Leave unset for production (global registration, up to ~1h
# before new commands appear).
DISCORD_DEV_GUILD=

# Log level — trace | debug | info | warn | error
RUST_LOG=bot_template_rs=debug,lavalink_rs=info,serenity=warn
